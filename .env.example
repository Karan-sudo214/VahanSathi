PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
DATA_PATH=./data/app.json
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Optional contact detail included in the geocoder User-Agent.
GEOCODER_CONTACT=

# Optional OSRM-compatible routing provider base URL. If unset, the app shows a clearly labelled approximate-distance estimate.
ROUTING_URL=

# Neon Postgres connection string (primary production cloud database). Keep private.
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Optional provider credentials. Keep secrets server-side.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Business identity details to publish prominently on the website.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
WEBSITE_DOMAIN=

# Set true only after a qualified tax adviser confirms the GST treatment and rate for the actual platform/driver contract model.
GST_RATE_APPROVED=false

# Customer support and statutory grievance contact details.
# Publish only official, monitored contact details controlled by VaahanSathi.
SUPPORT_EMAIL=
SUPPORT_PHONE=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# Private Cloudflare R2 bucket for CarCare, TripGuard, and expense evidence photos/receipts.
# Create a private bucket, then create an R2 API token with Object Read & Write access to that bucket.
# The server verifies uploaded expense images in R2 before accepting the expense request.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vaahansathi-tripguard
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Configure the bucket CORS policy in Cloudflare:
# Allowed origin: https://vaahansathi-demo-soky.onrender.com
# Allowed methods: PUT, GET, HEAD
# Allowed headers: Content-Type
# Expose headers: ETag
# Keep the bucket private; the app uses short-lived signed URLs.

# Firebase Authentication project used only for customer identity verification.
FIREBASE_PROJECT_ID=vahansathi-4ffae
