PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
DATA_PATH=./data/app.json
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Optional contact detail included in the geocoder User-Agent.
GEOCODER_CONTACT=

# Neon Postgres connection string (primary production cloud database). Keep private.
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Optional provider credentials. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
